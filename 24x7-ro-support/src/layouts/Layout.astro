---
import '../styles/global.css';
import Header from '../components/Header.astro';
import StickyBottomBar from '../components/StickyBottomBar.astro';

// Font imports
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Bangalore's trusted multi-brand RO water purifier repair, maintenance, installation, and AMC service provider. 60-min doorstep service with 90-day warranty." />
		<title>24x7 RO Service Department | Bangalore's Top Water Purifier Repair</title>
		
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "24x7 RO Service Department",
			"image": "https://24x7roservicedepartment.com/logo.jpg",
			"@id": "https://24x7roservicedepartment.com",
			"url": "https://24x7roservicedepartment.com",
			"telephone": "+918062180546",
			"priceRange": "₹₹",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Bangalore",
				"addressRegion": "KA",
				"addressCountry": "IN"
			},
			"aggregateRating": {
				"@type": "AggregateRating",
				"ratingValue": "4.7",
				"reviewCount": "12560"
			}
		}
		</script>
	</head>
	<body class="bg-white text-gray-800 font-sans antialiased pb-28 md:pb-0">
		
		<Header />
		
		<main class="min-h-screen">
			<slot /> 
		</main>

		<StickyBottomBar />
	</body>
</html>
