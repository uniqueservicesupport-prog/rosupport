---
// Yeh line current page ka URL check karti hai
const currentPath = Astro.url.pathname;
// Agar URL mein "ao-smith" hai, toh green hoga, warna blue
const isAOSmith = currentPath.includes('ao-smith');

// Colors set karna based on page
const bgLogo = isAOSmith ? 'bg-green-700' : 'bg-kent-blue';
const textLogo = isAOSmith ? 'text-green-700' : 'text-kent-blue';
const hoverColor = isAOSmith ? 'hover:text-green-700' : 'hover:text-kent-blue';
const menuHover = isAOSmith ? 'hover:bg-green-50' : 'hover:bg-blue-50';
const btnBg = isAOSmith ? 'bg-green-700' : 'bg-kent-blue';
const btnHover = isAOSmith ? 'hover:bg-green-800' : 'hover:bg-kent-dark';
const borderBtn = isAOSmith ? 'border-green-700 text-green-700' : 'border-kent-blue text-kent-blue';
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-3 md:px-4 py-3 flex justify-between items-center">
    
    <!-- Left Side: Logo (Dynamic Color & Smaller Text) -->
    <a href="/" class="flex items-center gap-2">
      <div class={`w-9 h-9 md:w-10 md:h-10 ${bgLogo} rounded-full flex items-center justify-center text-white font-bold text-lg md:text-xl shadow-md shrink-0`}>
        💧
      </div>
      <div class="flex flex-col justify-center">
        <!-- Yahan text-[13px] karke ek line mein fit kiya hai -->
        <h1 class={`text-[13px] sm:text-sm md:text-lg font-bold ${textLogo} leading-tight whitespace-nowrap`}>
          24x7 RO Service Department
        </h1>
        <p class="text-[8px] md:text-[10px] text-gray-500 uppercase tracking-wide font-semibold">
          Bangalore Water Experts
        </p>
      </div>
    </a>

    <!-- Right Side: Icons -->
    <div class="flex items-center gap-3 md:gap-5 text-gray-700">
      
      <button class={`${hoverColor} transition hidden sm:block`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>

      <button class={`${hoverColor} transition hidden sm:block`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </button>

      <a href="tel:08062180546" class={`${hoverColor} transition`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      </a>

      <button id="openMenuBtn" class={`${hoverColor} transition`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>

    </div>
  </div>
</header>

<!-- MOBILE SIDEBAR MENU -->
<div id="sideMenuOverlay" class="fixed inset-0 bg-black/60 z-[100] hidden transition-opacity backdrop-blur-sm">
  <div id="sideMenuContent" class="absolute top-0 right-0 w-[80%] max-w-sm h-full bg-white shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col">
    
    <div class="flex justify-between items-center p-5 border-b border-gray-100 bg-gray-50">
      <h2 class="text-xl font-bold text-gray-900">Menu</h2>
      <button id="closeMenuBtn" class="p-2 bg-gray-200 rounded-full text-gray-600 hover:bg-red-100 hover:text-red-500 transition">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto py-4 px-4 flex flex-col gap-2">
      <a href="/" class={`flex items-center gap-3 p-3 rounded-lg ${menuHover} text-gray-800 font-semibold transition`}><span class="text-xl">🏠</span> Home</a>
      <a href="/#services" class={`flex items-center gap-3 p-3 rounded-lg ${menuHover} text-gray-800 font-semibold transition`}><span class="text-xl">🔧</span> Our Services</a>
      <a href="/#pricing" class={`flex items-center gap-3 p-3 rounded-lg ${menuHover} text-gray-800 font-semibold transition`}><span class="text-xl">💰</span> Pricing & AMC Plans</a>
      <a href="/#areas" class={`flex items-center gap-3 p-3 rounded-lg ${menuHover} text-gray-800 font-semibold transition`}><span class="text-xl">📍</span> Areas We Serve</a>
      <a href="/#faq" class={`flex items-center gap-3 p-3 rounded-lg ${menuHover} text-gray-800 font-semibold transition`}><span class="text-xl">❓</span> FAQs</a>

      <div class="h-px bg-gray-200 my-2"></div>
      <p class="text-xs font-bold text-gray-400 uppercase tracking-wider px-3 mb-1">Legal Policies</p>

      <a href="/privacy" class={`flex items-center gap-3 p-2 px-3 text-sm text-gray-600 ${hoverColor} transition`}>Privacy Policy</a>
      <a href="/terms" class={`flex items-center gap-3 p-2 px-3 text-sm text-gray-600 ${hoverColor} transition`}>Terms & Conditions</a>
      <a href="/refund" class={`flex items-center gap-3 p-2 px-3 text-sm text-gray-600 ${hoverColor} transition`}>Refund Policy</a>
      <a href="/disclaimer" class={`flex items-center gap-3 p-2 px-3 text-sm text-gray-600 ${hoverColor} transition`}>Disclaimer</a>
    </div>

    <div class="p-4 border-t border-gray-100 bg-gray-50 space-y-3">
      <a href="/#booking-form" class={`block text-center w-full ${btnBg} text-white font-bold py-3 rounded-lg shadow-md ${btnHover} transition`}>Book Service Now</a>
      <a href="tel:08062180546" class={`block text-center w-full bg-white border-2 ${borderBtn} font-bold py-3 rounded-lg ${menuHover} transition flex items-center justify-center gap-2`}>
        📞 Call: 08062180546
      </a>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const openBtn = document.getElementById('openMenuBtn');
    const closeBtn = document.getElementById('closeMenuBtn');
    const overlay = document.getElementById('sideMenuOverlay');
    const menuPanel = document.getElementById('sideMenuContent');

    function openMenu() {
      overlay.classList.remove('hidden');
      setTimeout(() => { menuPanel.classList.remove('translate-x-full'); }, 10);
      document.body.style.overflow = 'hidden'; 
    }

    function closeMenu() {
      menuPanel.classList.add('translate-x-full');
      setTimeout(() => { overlay.classList.add('hidden'); }, 300);
      document.body.style.overflow = ''; 
    }

    if(openBtn && closeBtn && overlay) {
      openBtn.addEventListener('click', openMenu);
      closeBtn.addEventListener('click', closeMenu);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) closeMenu(); });
      const links = menuPanel.querySelectorAll('a');
      links.forEach(link => { link.addEventListener('click', closeMenu); });
    }
  });
</script>