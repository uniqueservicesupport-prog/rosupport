---
import Layout from '../layouts/Layout.astro';
---
<Layout>

  <!-- 1. PHOTO & TITLE SECTION -->
  <section class="bg-blue-50/50 py-8 px-4 border-b border-gray-200">
    <div class="max-w-4xl mx-auto text-center">
      
      <div class="w-full h-56 md:h-80 rounded-2xl shadow-lg overflow-hidden relative mb-6">
        <img 
          src="/kent-photo.jpg" 
          alt="Kent RO Repair Service in Bangalore" 
          class="w-full h-full object-cover" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-kent-blue/90 via-kent-blue/40 to-transparent flex flex-col justify-end p-6 text-left">
          <h1 class="text-3xl md:text-5xl font-extrabold text-white relative z-10">Kent RO Repair</h1>
          <p class="text-blue-100 mt-2 relative z-10 font-medium text-sm md:text-base">Bangalore's Trusted Service Center</p>
        </div>
      </div>

      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
        Expert <span class="text-kent-blue">Kent RO Service</span> in Bangalore
      </h2>
      <p class="text-gray-600 text-sm md:text-base">
        Get your Kent water purifier repaired at your doorstep within 60 minutes.
      </p>

    </div>
  </section>

  <!-- 2. FORM SECTION -->
  <section class="py-10 px-4 bg-gray-50 border-b border-gray-200">
    <div class="max-w-xl mx-auto">
      
      <div id="booking-form" class="bg-white p-6 md:p-8 rounded-2xl shadow-xl border border-gray-100 relative">
        <div class="absolute -top-3 -right-3 bg-kent-blue text-white text-xs font-bold px-3 py-1 rounded-full shadow-lg">Book Now</div>
        
        <h3 class="text-2xl font-bold text-gray-900 mb-1 text-center">Book Kent Repair</h3>
        <p class="text-sm text-gray-500 mb-6 text-center">Fill the form & our technician will call you in 5 mins.</p>
        
        <form id="bookingForm" class="space-y-4">
          
          <input type="hidden" name="_captcha" value="false">
          <input type="hidden" name="_subject" value="New KENT RO Booking Request!">
          <input type="hidden" name="brand" value="Kent">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Name</label>
              <input type="text" name="name" placeholder="Your Name" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-kent-blue focus:border-transparent transition">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Mobile</label>
              <input type="tel" name="mobile" placeholder="10-Digit Mobile" required maxlength="10" minlength="10" pattern="[0-9]{10}" title="Please enter exactly 10 digits" inputmode="numeric" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-kent-blue focus:border-transparent transition">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Pin Code</label>
              <input type="number" name="pincode" placeholder="560001" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-kent-blue focus:border-transparent transition">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Select Service</label>
              <select name="issue" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-kent-blue focus:border-transparent transition bg-white">
                <option value="" disabled selected>Choose Service...</option>
                <option value="Kent water purifier service">Kent Water Purifier Service</option>
                <option value="Kent water purifier repair">Kent Water Purifier Repair</option>
                <option value="Kent water purifier AMC">Kent Water Purifier AMC</option>
                <option value="Kent water purifier filter Replacement">Kent Water Purifier Filter Replacement</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Full Address</label>
            <textarea name="address" placeholder="Flat No, Building, Area..." rows="2" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-kent-blue focus:border-transparent transition"></textarea>
          </div>

          <button type="submit" class="w-full bg-kent-blue text-white font-bold text-lg py-3 rounded-lg hover:bg-kent-dark shadow-md transition">
            Book Kent Service Now
          </button>
          
          <p class="text-xs text-center text-gray-400 mt-2">No advance payment required.</p>
        </form>
      </div>

    </div>
  </section>

  <!-- 3. WORKING PHOTO SECTION -->
  <section class="py-10 px-4 bg-white border-b border-gray-100">
    <div class="max-w-3xl mx-auto text-center">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">Our <span class="text-kent-blue">Kent Expert</span> at Work</h3>
      
      <a href="#booking-form" class="block relative rounded-2xl overflow-hidden shadow-lg group">
        <img 
          src="/technician-photo.jpg" 
          alt="Kent RO Technician at work" 
          class="w-full h-48 md:h-72 object-cover transition-transform duration-500 group-hover:scale-105" 
        />
        <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-300">
          <span class="bg-kent-blue text-white font-bold px-6 py-3 rounded-lg text-lg shadow-lg">Book Service Now</span>
        </div>
      </a>
      <p class="text-sm text-gray-500 mt-4">100% Genuine Spare Parts & Background Verified Technicians</p>
    </div>
  </section>

  <!-- 4. DESCRIPTION SECTION -->
  <section class="py-12 px-4 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto">
      
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6 border-b pb-3 border-gray-200">
        Our <span class="text-kent-blue">Kent Services</span> in Bangalore
      </h2>

      <div class="prose max-w-none text-gray-700 text-justify space-y-4">
        <p class="text-lg font-medium text-gray-900">
          Is your Kent RO leaking water, making unusual noise, or giving a bad taste? Don't worry! 
        </p>
        <p>
          We are Bangalore's leading independent <strong>Kent RO repair service center</strong>. Whether you have a Kent Grand, Kent Supreme, or any other model, our expert technicians can fix it on the spot. We understand that Bangalore's hard water damages RO membranes quickly, which is why we use 100% genuine spare parts to ensure your water is safe and sweet.
        </p>

        <ul class="list-none space-y-3 my-6">
          <li class="flex items-start gap-3">
            <span class="text-green-500 text-xl">✅</span>
            <span><strong>Common Kent Issues Fixed:</strong> Pump failure, SMPS burnout, continuous waste water, filter clogging, and motor vibration.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-500 text-xl">✅</span>
            <span><strong>Genuine Kent Spares:</strong> We use original filters, membranes, and pumps with a 90-day warranty.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-green-500 text-xl">✅</span>
            <span><strong>60-Minute Arrival:</strong> Our technicians are located across Bangalore (Whitefield, HSR, Koramangala, etc.) to reach you fast.</span>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- 5. WHY CHOOSE US -->
  <section class="py-16 bg-gray-50 px-4 border-b border-gray-200">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-gray-900">Why Choose Our Kent Experts?</h2>
        <p class="text-gray-600 mt-2">We are not just any service center; we specialize in Kent RO repairs.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 text-center">
          <div class="text-4xl mb-3">🔧</div>
          <h3 class="font-bold text-gray-900 mb-2">Kent Specialists</h3>
          <p class="text-sm text-gray-600">Our technicians are specifically trained to handle all Kent models, including Grand and Supreme.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 text-center">
          <div class="text-4xl mb-3">🛡️</div>
          <h3 class="font-bold text-gray-900 mb-2">Genuine Parts</h3>
          <p class="text-sm text-gray-600">We never use local duplicates. Only 100% original Kent spare parts with a 90-day warranty.</p>
        </div>
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 text-center">
          <div class="text-4xl mb-3">⏱️</div>
          <h3 class="font-bold text-gray-900 mb-2">Fast Service</h3>
          <p class="text-sm text-gray-600">We know clean water is important. That's why we reach your doorstep within 60 minutes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. HOW IT WORKS (NEW SECTION replacing Pricing) -->
  <section class="py-16 bg-white px-4 border-b border-gray-200">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900">How Our Kent Service Works</h2>
        <p class="text-gray-600 mt-2">Fast, transparent, and hassle-free doorstep repair.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- Step 1 -->
        <div class="text-center relative z-10">
          <div class="w-16 h-16 mx-auto bg-blue-50 border-4 border-white text-kent-blue rounded-full flex items-center justify-center text-2xl font-bold shadow-md mb-4">1</div>
          <h3 class="font-bold text-gray-900 text-lg mb-2">Book Appointment</h3>
          <p class="text-sm text-gray-600">Fill the form or call us. We confirm your booking instantly.</p>
        </div>
        
        <!-- Step 2 -->
        <div class="text-center relative z-10">
          <div class="w-16 h-16 mx-auto bg-blue-50 border-4 border-white text-kent-blue rounded-full flex items-center justify-center text-2xl font-bold shadow-md mb-4">2</div>
          <h3 class="font-bold text-gray-900 text-lg mb-2">Expert Visits You</h3>
          <p class="text-sm text-gray-600">Our verified Kent technician arrives at your doorstep within 60 minutes.</p>
        </div>
        
        <!-- Step 3 -->
        <div class="text-center relative z-10">
          <div class="w-16 h-16 mx-auto bg-blue-50 border-4 border-white text-kent-blue rounded-full flex items-center justify-center text-2xl font-bold shadow-md mb-4">3</div>
          <h3 class="font-bold text-gray-900 text-lg mb-2">Repair & Warranty</h3>
          <p class="text-sm text-gray-600">We fix the issue with genuine parts and give you a 90-day warranty.</p>
        </div>
        
        <!-- Connecting Line (Desktop only) -->
        <div class="hidden md:block absolute top-8 left-[16%] right-[16%] h-1 bg-gray-100 -z-0"></div>
      </div>
      
      <div class="text-center mt-10">
         <a href="#booking-form" class="inline-block bg-kent-blue text-white font-bold px-8 py-3 rounded-lg shadow-md hover:bg-kent-dark transition">Book Your Kent Service Now</a>
      </div>
    </div>
  </section>

  <!-- 7. TESTIMONIALS -->
  <section class="py-16 bg-gray-50 px-4 border-b border-gray-200">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-gray-900 mb-2">What Kent Users Say About Us</h2>
        <p class="text-gray-600">Real reviews from real Kent RO owners in Bangalore.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex text-yellow-500 mb-3">⭐⭐⭐⭐⭐</div>
          <p class="text-gray-700 text-sm mb-4 italic">"My Kent Grand Plus stopped working. I called them and the technician arrived in just 40 minutes. Fixed the SMPS issue quickly."</p>
          <div class="font-bold text-gray-900 text-sm">- Vikram R. (Indiranagar)</div>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex text-yellow-500 mb-3">⭐⭐⭐⭐⭐</div>
          <p class="text-gray-700 text-sm mb-4 italic">"They changed my Kent RO filters. The technician was very polite and showed me the TDS reading before and after. Highly recommend."</p>
          <div class="font-bold text-gray-900 text-sm">- Sneha K. (HSR Layout)</div>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex text-yellow-500 mb-3">⭐⭐⭐⭐⭐</div>
          <p class="text-gray-700 text-sm mb-4 italic">"Water was leaking from my Kent purifier. They fixed the pipe connection at a very reasonable price. Genuine service."</p>
          <div class="font-bold text-gray-900 text-sm">- Manoj D. (Whitefield)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. FAQs -->
  <section class="py-16 bg-white px-4 border-b border-gray-200">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-gray-900 text-center mb-8">Kent RO Service FAQs</h2>
      
      <div class="space-y-4">
        <details class="bg-gray-50 border border-gray-200 rounded-lg p-4 cursor-pointer group shadow-sm" open>
          <summary class="font-bold text-gray-900 flex justify-between items-center list-none">
            How much does Kent RO service cost in Bangalore?
            <span class="text-kent-blue group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-gray-600 text-sm">The basic visit and diagnosis charge is ₹299. This amount is completely waived off if you get your Kent RO repaired by us. Spare parts are charged separately based on the issue.</p>
        </details>

        <details class="bg-gray-50 border border-gray-200 rounded-lg p-4 cursor-pointer group shadow-sm">
          <summary class="font-bold text-gray-900 flex justify-between items-center list-none">
            Do you use genuine Kent RO spare parts?
            <span class="text-kent-blue group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-gray-600 text-sm">Yes, we only use 100% original Kent filters, membranes, and pumps. All replaced parts come with a 90-day warranty.</p>
        </details>
        
        <details class="bg-gray-50 border border-gray-200 rounded-lg p-4 cursor-pointer group shadow-sm">
          <summary class="font-bold text-gray-900 flex justify-between items-center list-none">
            My Kent RO is out of warranty. Can you still repair it?
            <span class="text-kent-blue group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-gray-600 text-sm">Absolutely! We are an independent service center. We provide out-of-warranty repairs for all Kent models at very affordable rates.</p>
        </details>

        <details class="bg-gray-50 border border-gray-200 rounded-lg p-4 cursor-pointer group shadow-sm">
          <summary class="font-bold text-gray-900 flex justify-between items-center list-none">
            How long does it take to repair a Kent RO?
            <span class="text-kent-blue group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-gray-600 text-sm">Most common issues (like leaks, pump failure, or filter changes) are fixed on the spot within 30-45 minutes.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- 9. SERVICE AREAS -->
  <section class="py-12 bg-gray-50 px-4 text-center border-b border-gray-200">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Kent RO Repair in Your Area</h2>
      <div class="flex flex-wrap justify-center gap-2">
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Whitefield</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Koramangala</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">HSR Layout</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Indiranagar</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Electronic City</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Jayanagar</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Marathahalli</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">BTM Layout</span>
      </div>
    </div>
  </section>

  <!-- 10. FOOTER -->
  <footer class="bg-gray-900 text-white pt-12 px-4 pb-32 md:pb-8 border-t-4 border-kent-blue">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-1">
        <h3 class="text-2xl font-bold mb-4 text-white">24x7 RO Service Department</h3>
        <p class="text-gray-400 text-sm mb-4 leading-relaxed">Bangalore's trusted multi-brand RO water purifier repair, maintenance, installation, and AMC service provider.</p>
        <p class="text-gray-400 text-sm mb-2">📞 08062180546</p>
        <p class="text-gray-400 text-sm mb-2">✉️ support@24x7roservicedepartment.com</p>
        <p class="text-gray-400 text-sm">📍 Bangalore, Karnataka</p>
      </div>
      <div>
        <h4 class="text-lg font-bold mb-4 text-white">Our Services</h4>
        <ul class="text-gray-400 text-sm space-y-2">
          <li><a href="/" class="hover:text-white transition">RO Repair & Service</a></li>
          <li><a href="/" class="hover:text-white transition">Filter Replacement</a></li>
          <li><a href="/" class="hover:text-white transition">Installation & Moving</a></li>
          <li><a href="/" class="hover:text-white transition">AMC Plans</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-lg font-bold mb-4 text-white">Quick Links</h4>
        <ul class="text-gray-400 text-sm space-y-2">
          <li><a href="/" class="hover:text-white transition">Home</a></li>
          <li><a href="#booking-form" class="hover:text-white transition">Book Appointment</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-lg font-bold mb-4 text-white">Legal & Policies</h4>
        <ul class="text-gray-400 text-sm space-y-2">
          <li><a href="/privacy" class="hover:text-white transition">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition">Terms & Conditions</a></li>
          <li><a href="/refund" class="hover:text-white transition">Refund Policy</a></li>
          <li><a href="/cookie" class="hover:text-white transition">Cookie Policy</a></li>
          <li><a href="/disclaimer" class="hover:text-white transition">Disclaimer</a></li>
        </ul>
      </div>
    </div>
    
    <!-- STRONG DISCLAIMER BOX -->
    <div class="max-w-6xl mx-auto mt-8 bg-gray-800 p-4 rounded-lg border border-gray-700 shadow-inner">
      <p class="text-xs md:text-sm text-gray-300 text-center font-semibold">
        <strong class="text-white">Disclaimer:</strong> 24x7 RO Service Department is an independent, third-party multi-brand RO water purifier repair and service center in Bangalore. Brand names & logos belong to their respective owners and are referenced solely for compatibility identification. We are <strong class="text-white underline">NOT</strong> an authorized service partner of any brand.
      </p>
    </div>

    <!-- Copyright Text -->
    <div class="max-w-6xl mx-auto mt-6 pt-6 border-t border-gray-800 text-center text-gray-500 text-sm">
      <p>© 2024 24x7 RO Service Department. All rights reserved.</p>
    </div>
  </footer>

