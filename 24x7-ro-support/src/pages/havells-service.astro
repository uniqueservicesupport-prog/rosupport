  <!-- 7. TESTIMONIALS -->
  <section class="py-16 bg-blue-50 px-4 border-b border-gray-200">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-gray-900 mb-2">What Havells Users Say About Us</h2>
        <p class="text-gray-600">Real reviews from real Havells Water Purifier owners in Bangalore.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex text-yellow-500 mb-3">⭐⭐⭐⭐⭐</div>
          <p class="text-gray-700 text-sm mb-4 italic">"My Havells Max stopped working. I called them and the technician arrived in just 40 minutes. Fixed the SMPS issue quickly."</p>
          <div class="font-bold text-gray-900 text-sm">- Vikas S. (Indiranagar)</div>
        </div>
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm">
          <div class="flex text-yellow-500 mb-3">⭐⭐⭐⭐⭐</div>
