        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Indiranagar</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Electronic City</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Jayanagar</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">Marathahalli</span>
        <span class="bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium border border-gray-200">BTM Layout</span>
      </div>
    </div>
  </section>

