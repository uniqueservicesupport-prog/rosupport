      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <div class="text-center relative z-10">
          <div class="w-16 h-16 mx-auto bg-blue-50 border-4 border-white text-blue-900 rounded-full flex items-center justify-center text-2xl font-bold shadow-md mb-4">1</div>
          <h3 class="font-bold text-gray-900 text-lg mb-2">Book Appointment</h3>
          <p class="text-sm text-gray-600">Fill the form or call us. We confirm your booking instantly.</p>
        </div>
        
        <div class="text-center relative z-10">
          <div class="w-16 h-16 mx-auto bg-blue-50 border-4 border-white text-blue-900 rounded-full flex items-center justify-center text-2xl font-bold shadow-md mb-4">2</div>
          <h3 class="font-bold text-gray-900 text-lg mb-2">Expert Visits You</h3>
          <p class="text-sm text-gray-600">Our verified Havells technician arrives at your doorstep within 60 minutes.</p>
        </div>
        
        <div class="text-center relative z-10">
          <div class="w-16 h-16 mx-auto bg-blue-50 border-4 border-white text-blue-900 rounded-full flex items-center justify-center text-2xl font-bold shadow-md mb-4">3</div>
          <h3 class="font-bold text-gray-900 text-lg mb-2">Repair & Warranty</h3>
          <p class="text-sm text-gray-600">We fix the issue with genuine parts and give you a 90-day warranty.</p>
        </div>
        
