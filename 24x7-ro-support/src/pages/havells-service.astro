  <!-- FAQ Schema Markup for Google SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much does Havells RO service cost in Bangalore?",
        "acceptedAnswer": {
          "@type": "Answer",
