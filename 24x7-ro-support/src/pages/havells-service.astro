---
import Layout from '../layouts/Layout.astro';
---
<Layout>

  <!-- 1. PHOTO & TITLE SECTION -->
  <section class="bg-blue-50 py-8 px-4 border-b border-gray-200">
    <div class="max-w-4xl mx-auto text-center">
      
      <div class="w-full h-56 md:h-80 rounded-2xl shadow-lg overflow-hidden relative mb-6">
        <img 
          src="/havells-photo.jpg" 
          alt="Havells Water Purifier Repair Service in Bangalore" 
          class="w-full h-full object-cover" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-blue-950/95 via-blue-900/80 to-transparent flex flex-col justify-end p-6 text-left">
          <h1 class="text-2xl md:text-4xl font-extrabold text-white relative z-10 drop-shadow-md mb-1">Havells Water Purifier Service</h1>
          <p class="text-gray-100 relative z-10 font-medium text-sm md:text-base drop-shadow-md">Bangalore's Trusted Service Center</p>
        </div>
      </div>

      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
        Expert <span class="text-blue-900">Havells RO Service</span> in Bangalore
      </h2>
      <p class="text-gray-700 text-sm md:text-base">
        Get your Havells water purifier repaired at your doorstep within 60 minutes.
      </p>

    </div>
  </section>

  <!-- 2. FORM SECTION -->
  <section class="py-10 px-4 bg-blue-50 border-b border-gray-200">
    <div class="max-w-xl mx-auto">
      
      <div id="booking-form" class="bg-white p-6 md:p-8 rounded-2xl shadow-xl border border-gray-100 relative">
        <div class="absolute -top-3 -right-3 bg-blue-900 text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-lg z-10">Book Now</div>
        
        <h3 class="text-2xl font-bold text-gray-900 mb-1 text-center mt-2">Book Havells Repair</h3>
        <p class="text-sm text-gray-500 mb-6 text-center">Fill the form & our technician will call you in 5 mins.</p>
        
        <form id="bookingForm" class="space-y-4">
          
          <!-- Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="1d5d47df-4a9a-4f20-ba78-7aa07022894e">
          <input type="hidden" name="_subject" value="New HAVELLS Water Purifier Booking Request!">
          <input type="hidden" name="brand" value="Havells">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Name</label>
              <input type="text" name="name" placeholder="Your Name" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent transition">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Mobile</label>
              <input type="tel" name="mobile" placeholder="10-Digit Mobile" required maxlength="10" minlength="10" pattern="[0-9]{10}" title="Please enter exactly 10 digits" inputmode="numeric" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent transition">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Pin Code</label>
              <input type="number" name="pincode" placeholder="560001" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent transition">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Select Service</label>
              <select name="issue" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent transition bg-white">
                <option value="" disabled selected>Choose Service...</option>
                <option value="Havells water purifier service">Havells Water Purifier Service</option>
                <option value="Havells water purifier repair">Havells Water Purifier Repair</option>
                <option value="Havells water purifier AMC">Havells Water Purifier AMC</option>
                <option value="Havells water purifier filter Replacement">Havells Water Purifier Filter Replacement</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Full Address</label>
            <textarea name="address" placeholder="Flat No, Building, Area..." rows="2" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent transition"></textarea>
          </div>

          <button type="submit" class="w-full text-white font-bold text-lg py-3 rounded-lg shadow-md transition hover:opacity-90" style="background-color: #0f172a;">
            Book Havells Service Now
          </button>
          
          <p class="text-xs text-center text-gray-400 mt-2">No advance payment required.</p>
        </form>
      </div>

    </div>
  </section>

  <!-- 3. WORKING PHOTO SECTION -->
  <section class="py-10 px-4 bg-white border-b border-gray-100">
    <div class="max-w-3xl mx-auto text-center">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">Our <span class="text-blue-900">Havells Expert</span> at Work</h3>
      
      <a href="#booking-form" class="block relative rounded-2xl overflow-hidden shadow-lg group">
        <img 
          src="/havells-technician.jpg" 
          alt="Havells RO Technician at work" 
          class="w-full h-48 md:h-72 object-cover transition-transform duration-500 group-hover:scale-105" 
        />
        <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-300">
          <span class="bg-blue-900 text-white font-bold px-6 py-3 rounded-lg text-lg shadow-lg">Book Service Now</span>
        </div>
      </a>
      <p class="text-sm text-gray-500 mt-4">100% Genuine Spare Parts & Background Verified Technicians</p>
    </div>
  </section>

  <!-- 4. DESCRIPTION SECTION -->
  <section class="py-12 px-4 bg-white border-b border-gray-100">
    <div class="max-w-4xl mx-auto">
      
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6 border-b pb-3 border-gray-200">
        Our <span class="text-blue-900">Havells Services</span> in Bangalore
      </h2>

      <div class="prose max-w-none text-gray-700 text-justify space-y-4">
        <p class="text-lg font-medium text-gray-900">
          Is your Havells RO leaking water, making unusual noise, or giving a bad taste? Don't worry! 
        </p>
        <p>
          We are Bangalore's leading independent <strong>Havells Water Purifier repair service center</strong>. Whether you have a Havells Max, Havells Pro, or any other model, our expert technicians can fix it on the spot. We understand that Bangalore's hard water damages RO membranes quickly, which is why we use 100% genuine spare parts to ensure your water is safe and sweet.
        </p>

        <ul class="list-none space-y-3 my-6">
          <li class="flex items-start gap-3">
            <span class="text-blue-600 text-xl">✅</span>
            <span><strong>Common Havells Issues Fixed:</strong> Pump failure, SMPS burnout, continuous waste water, filter clogging, and motor vibration.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-blue-600 text-xl">✅</span>
            <span><strong>Genuine Havells Spares:</strong> We use original filters, membranes, and pumps with a 90-day warranty.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-blue-600 text-xl">✅</span>
            <span><strong>60-Minute Arrival:</strong> Our technicians are located across Bangalore (Whitefield, HSR, Koramangala, etc.) to reach you fast.</span>
          </li>
        </ul>
      </div>

    </div>
  </section>

  <!-- 5. WHY CHOOSE US -->
  <section class="py-16 bg-blue-50 px-4 border-b border-gray-200">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-gray-900">Why Choose Our Havells Experts?</h2>
        <p class="text-gray-600 mt-2">We are not just any service center; we specialize in Havells Water Purifier repairs.</p>
      </div>

